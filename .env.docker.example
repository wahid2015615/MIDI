# Copy to .env.docker and adjust for your machine / Oracle VM public IP.
# Usage: docker compose --env-file .env.docker up --build

# URL the *browser* uses to reach the API (rebuild frontend after changing this)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3001

# Backend
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=3072
LOCAL_N_CTX=4096
MODEL_IDLE_UNLOAD_SECONDS=120
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional shared secret (set the same value in Studio via rebuild arg / env)
# MIDIGEN_API_TOKEN=

# GENERATED_ARCHIVE_MAX=200

# --- Oracle Free VM example ---
# NEXT_PUBLIC_API_URL=http://YOUR_PUBLIC_IP:8000
# CORS_ORIGINS=http://YOUR_PUBLIC_IP:3001
