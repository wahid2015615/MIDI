# Local GGUF model (no cloud API key)
# Default path: backend/models/Qwen3-4B-Q4_K_M.gguf
# LOCAL_MODEL_PATH=models/Qwen3-4B-Q4_K_M.gguf

AI_TEMPERATURE=0.3
AI_MAX_TOKENS=3072
LOCAL_N_CTX=4096
# LOCAL_N_THREADS=6
LOCAL_N_GPU_LAYERS=0

HOST=127.0.0.1
PORT=8000
# Fail if PORT is busy (keeps frontend NEXT_PUBLIC_API_URL in sync).
# PORT_FALLBACK=1

# Extra browser origins for deploy (comma-separated). Localhost:3000/3001 always allowed.
# CORS_ORIGINS=https://your-frontend-domain
# Empty string disables the default private-LAN origin regex.
# CORS_ORIGIN_REGEX=

# Dev auto-reload (restart manually after pulls unless set to 1).
# UVICORN_RELOAD=1
