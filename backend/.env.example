# Local GGUF model (no cloud API key)
# Default path: backend/models/Qwen3-4B-Q4_K_M.gguf
# LOCAL_MODEL_PATH=models/Qwen3-4B-Q4_K_M.gguf

AI_TEMPERATURE=0.3
AI_MAX_TOKENS=3072
LOCAL_N_CTX=4096
# LOCAL_N_THREADS=6
LOCAL_N_GPU_LAYERS=0

# Unload the GGUF from RAM after this many idle seconds (default 120; minimum 5).
# MODEL_IDLE_UNLOAD_SECONDS=120

HOST=127.0.0.1
PORT=8000
# Fail if PORT is busy (keeps frontend NEXT_PUBLIC_API_URL in sync).
# PORT_FALLBACK=1

# Extra browser origins for deploy (comma-separated). Localhost:3000/3001 always allowed.
# CORS_ORIGINS=https://your-frontend-domain
# Docker / Oracle VM examples:
# HOST=0.0.0.0
# CORS_ORIGINS=http://localhost:3001,http://YOUR_PUBLIC_IP:3001
# Empty string disables the default private-LAN origin regex.
# When HOST is non-loopback (0.0.0.0), LAN regex is off unless you set this.
# CORS_ORIGIN_REGEX=

# Optional shared secret for text generate + health?probe=1
# (Authorization: Bearer … or X-MIDI-Token). Mirror on Studio: NEXT_PUBLIC_API_TOKEN.
# MIDIGEN_API_TOKEN=

# Cap archived .mid files under backend/generated/ (oldest pruned).
# GENERATED_ARCHIVE_MAX=200

# Dev auto-reload (server restarts on code changes).
# Docker Compose forces UVICORN_RELOAD=0 — keep 1 only for local `python run.py`.
UVICORN_RELOAD=1
